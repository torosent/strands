# Cloudflare Pages builds with `npx @cloudflare/next-on-pages@1`. Its peer ranges no longer
# resolve on npm 10 (latest wrangler wants @cloudflare/workers-types v5, next-on-pages v4),
# so npx fails with ERESOLVE before building. Ignore peer conflicts until we move off
# next-on-pages (deprecated; Cloudflare recommends the OpenNext adapter).
legacy-peer-deps=true
